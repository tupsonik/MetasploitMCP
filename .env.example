# Required Metasploit RPC credentials
MSF_PASSWORD=change-me
MSF_SERVER=127.0.0.1
MSF_PORT=55553
MSF_SSL=false

# Payload output directory
PAYLOAD_SAVE_DIR=./payloads

# Logging
LOG_LEVEL=info

# High-impact MCP capabilities are disabled by default.
# Enable only the capabilities you actually need.
MCP_ALLOW_ACTIVE_ACTIONS=false
MCP_ALLOW_SESSION_CONTROL=false
MCP_ALLOW_PAYLOAD_GENERATION=false
MCP_ALLOW_LISTENER_CONTROL=false

# Input/resource limits
MCP_MAX_COMMAND_LENGTH=4096
MCP_MAX_TOOL_TIMEOUT=300

# HTTP authentication.
# "auto" requires Bearer auth when --host is not loopback.
MCP_REQUIRE_AUTH=auto
MCP_AUTH_TOKEN=replace-with-a-long-random-token
